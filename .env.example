# Copy to .env.local for local work, or run `vercel env pull .env.local`.
# On Vercel these are set by the Supabase Marketplace integration. Do not add them by hand.
# The integration also sets the older anon and service role keys and a set of POSTGRES_* values;
# the app reads only the ones below.

# Supabase project URL and publishable key. Safe in the browser: row level security guards the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Bypasses row level security, so it never goes near a client component.
SUPABASE_SECRET_KEY=

# Direct Postgres connection, for migrations only.
POSTGRES_URL_NON_POOLING=
