# Copy to .env.local for local work, or run `vercel env pull .env.local`.

# Brevo, for the club waitlist. Server only: never prefix these with NEXT_PUBLIC_.
# The key is made in Brevo under SMTP & API > API keys.
BREVO_API_KEY=
# The number of the contact list the waitlist goes into (Contacts > Lists, the ID column).
BREVO_WAITLIST_LIST_ID=

# Sign-in by email link. AUTH_SECRET signs the link and the session cookie: at least 32 random
# characters, e.g. `openssl rand -base64 48`. Changing it signs everyone out.
AUTH_SECRET=
# The address the sign-in email comes from. It must be a verified sender in Brevo
# (Senders, Domains & Dedicated IPs), ideally on an authenticated gafferboard.com domain.
BREVO_SENDER_EMAIL=
