# Copy to .env.local for local work, or run `vercel env pull .env.local`.

# Brevo, for the club waitlist. Server only: never prefix these with NEXT_PUBLIC_.
# The key is made in Brevo under SMTP & API > API keys.
BREVO_API_KEY=
# The number of the contact list the waitlist goes into (Contacts > Lists, the ID column).
BREVO_WAITLIST_LIST_ID=
